{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Tauri",
  "version": "0.2.0",
  "identifier": "io.github.dshwsl.shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "local-manager",
          "windows": [
            "manager"
          ],
          "local": true,
          "permissions": [
            "allow-manage",
            "allow-startup-mode"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}
